# Google Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Backend Port (default 3001)
PORT=3001

# Gemini Model (defaults to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Google OAuth 2.0 Web application credentials (backend only; never use VITE_ prefix)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Dev callback is served by the Vite /api proxy on port 5173.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Admin account bootstrap (set a unique, strong password of at least 14 characters)
# These values are read by the backend only and must never use the VITE_ prefix.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-secret

# Optional SQLite database location (defaults to ./data/feedback.sqlite)
# FEEDBACK_DB_PATH=data/feedback.sqlite

# Optional production browser origin for admin state-changing API requests
# APP_ORIGIN=https://chatbot.example.com
